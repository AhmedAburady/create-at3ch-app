# The shared access code. Required: without it the app won't start.
ACCESS_CODE=

# Seals the session cookie: at least 32 random characters, e.g.
# `openssl rand -base64 32`. Change it to sign every browser out.
SESSION_SECRET=

# 0 when nothing sits in front of the server. Behind proxies: which entry of
# X-Forwarded-For, counted from the end, is the client (1 behind one proxy
# that appends it, 2 behind Google Cloud's load balancer).
TRUST_PROXY_HOPS=0
