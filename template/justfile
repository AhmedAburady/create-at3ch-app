# Run `just` to see every recipe, modules included.

# Docker commands
mod docker

# List every recipe, submodules included.
default:
    @just --list --list-submodules

# Install dependencies.
install:
    bun install

# Run the dev server on :3000.
dev:
    bun run dev

# Build for production into dist/.
build:
    bun run build

# Serve the production build with the Bun server.
start: build
    bun run start

# Format-check, lint and typecheck with Vite+.
check:
    bun run check

# Format and fix what Vite+ can, then lint and typecheck.
fix:
    bun run fix

# Test: unit tests and the production build over HTTP.
test:
    bun run test

# Update every package to its latest version, then point the Vite+
# overrides at the versions it now bundles.
update:
    bun update --latest
    bun pm pkg set overrides.vite="$(bun -p 'require("./package.json").devDependencies.vite')" overrides.vitest="$(bun -p 'require("./node_modules/vite-plus/package.json").dependencies.vitest')"
    bun install
